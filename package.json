{
  "name": "iiot-detection-evaluation",
  "version": "1.0.0",
  "description": "Evaluate and compare saved binary IIoT detection predictions",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "files": ["dist", "data", "README.md", "LICENSE", ".nvmrc"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "evaluate": "node dist/cli.js",
    "demo": "node dist/cli.js --input data/example.csv --compare data/candidate.csv --output results",
    "verify": "npm run typecheck && npm test && npm run build && npm run demo"
  },
  "dependencies": { "csv-parse": "7.0.3" },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
